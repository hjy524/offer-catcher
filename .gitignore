# ===========================================
# Git 忽略文件配置
# ===========================================

# 环境变量文件（包含敏感信息）
.env
.env.local
.env.*.local

# 依赖目录
node_modules/
dist/
build/

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 编辑器配置
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 临时文件
*.tmp
*.temp
.cache/

# 测试覆盖率
coverage/
.nyc_output/

# 构建产物
*.log
*.tgz